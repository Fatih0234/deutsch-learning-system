{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "German Learning Structures State",
  "type": "object",
  "required": [
    "schema_version",
    "structures"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pattern",
          "status",
          "attempts",
          "successful_uses"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "status": {
            "enum": [
              "introduced",
              "practicing",
              "improving",
              "stable",
              "mastered"
            ]
          },
          "rule": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "successful_uses": {
            "type": "integer",
            "minimum": 0
          },
          "first_seen": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
